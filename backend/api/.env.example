# Copie para .env (fora do git). Nunca commitar valores reais.
PORTA=3001
BD_HOST=localhost
BD_PORTA=3306
BD_NOME=edutrack
# Usuário da API: criado por "npm.cmd run preparar-banco", sem DELETE nas tabelas de dados.
BD_USUARIO=edutrack_api
BD_SENHA=troque-por-uma-senha-forte
# Só para preparar o banco (cria o banco, as tabelas e o usuário da API).
BD_ADMIN_USUARIO=root
BD_ADMIN_SENHA=senha-do-root
# Mínimo 32 caracteres aleatórios. Assina as URLs das fotos.
SEGREDO_FOTOS=troque-por-32-ou-mais-caracteres-aleatorios
# Opcionais (padrões entre parênteses): PASTA_FOTOS (dados/fotos), PASTA_FRONTEND (../../frontend/dist)
